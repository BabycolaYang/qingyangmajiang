generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nickname  String
  beanBalance Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgers   BeanLedger[]
  seats     GameSeat[]
}

model Room {
  id              String   @id @default(uuid())
  roomCode        String   @unique
  ownerUserId     String
  status          String
  roundsTotal     Int
  baseScore       Int      @default(5)
  mustLackOneSuit Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  games Game[]
}

model Game {
  id           String   @id @default(uuid())
  roomId       String
  roundIndex   Int
  dealerSeat   Int
  laiziTile    String?
  indicatorTile String?
  status       String
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())

  room    Room       @relation(fields: [roomId], references: [id])
  seats   GameSeat[]
  events  GameEvent[]
  ledgers BeanLedger[]
}

model GameSeat {
  id       String @id @default(uuid())
  gameId   String
  userId   String
  seat     Int
  beanDelta Int @default(0)

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, seat])
  @@unique([gameId, userId])
}

model GameEvent {
  id        String   @id @default(uuid())
  gameId    String
  index     Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id])

  @@unique([gameId, index])
}

model BeanLedger {
  id          String   @id @default(uuid())
  userId      String
  gameId      String?
  idempotencyKey String @unique
  reason      String
  delta       Int
  balanceAfter Int
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  game Game? @relation(fields: [gameId], references: [id])
}

